{
  "$comment": "The single source for response headers. vercel.ts turns these into the deploy config, and scripts/check-served.mjs fetches the running site and asserts the headers it depends on, so the guard cannot drift from what is actually served.",
  "rules": [
    {
      "source": "/_next/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "source": "/media/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "source": "/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/benchmarks/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/vs/browser-use-cloud/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/vs/browserbase/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/og/docs/(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "source": "/llms-full.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "$comment": "A megabyte of JSON holding the full text of every docs page. It has to stay public for the docs search to work, but it is a third copy of the corpus after the HTML and the generated markdown, so it is kept out of the index.",
      "source": "/api/search",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "public, max-age=3600",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "source": "/(.*).html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "source": "/",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Vary": "Accept, Accept-Encoding"
      }
    },
    {
      "source": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN"
      }
    }
  ]
}
