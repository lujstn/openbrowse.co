{
  "$comment": "The single source for response headers. vercel.ts turns these into the deploy config, and scripts/check-export.mjs asserts against the same list, so the guard cannot drift from what is actually served.",
  "rules": [
    {
      "source": "/_next/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "source": "/media/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "source": "/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/benchmarks/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/vs/browser-use-cloud/opengraph-image-(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/og/docs/(.*)",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "source": "/(.*).md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "source": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "source": "/llms-full.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=300, must-revalidate"
      }
    },
    {
      "source": "/api/search",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "source": "/(.*).html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "source": "/",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "source": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN"
      }
    }
  ]
}
